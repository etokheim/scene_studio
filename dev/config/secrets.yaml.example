# Copy to secrets.yaml and fill in real values. secrets.yaml is gitignored.
# https://www.home-assistant.io/docs/configuration/secrets/

# Long-lived access token for Cursor agents (sandbox Profile → Long-Lived Access Tokens).
# Used only as Authorization: Bearer … against http://127.0.0.1:8123/api/
# See .cursor/skills/home-assistant-api/SKILL.md
cursor_ha_token: CHANGEME

# Sandbox UI login for Chrome DevTools MCP (http://127.0.0.1:8123/circadian_scenes).
# Not the live home. If either key is missing, the agent should ask rather than guess.
sandbox_ha_username: CHANGEME
sandbox_ha_password: CHANGEME
